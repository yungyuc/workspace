#!/bin/sh
SSHV="SSH_CLIENT SSH_TTY SSH_AUTH_SOCK SSH_CONNECTION DISPLAY"
if [ -z "$SSHENVPATH" ]; then
  echo "Warning: SSHENVPATH is not set; not saving SSH environment" >&2
  exit 1
fi
mkdir -p "$(dirname "$SSHENVPATH")"
for x in ${SSHV} ; do
    (eval echo $x=\$$x) | sed  's/=/="/
                                s/$/"/
                                s/^/export /'
done 1>"$SSHENVPATH"
chmod 600 "$SSHENVPATH"
